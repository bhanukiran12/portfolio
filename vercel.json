{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/robots.txt", "has": [{ "type": "host", "value": "(www\\.)?bhanubeyond\\.com|bhanukiran\\.vercel\\.app" }], "destination": "/personal-robots.txt" },
    { "source": "/sitemap.xml", "has": [{ "type": "host", "value": "(www\\.)?bhanubeyond\\.com|bhanukiran\\.vercel\\.app" }], "destination": "/personal-sitemap.xml" },
    { "source": "/llms.txt", "has": [{ "type": "host", "value": "(www\\.)?bhanubeyond\\.com|bhanukiran\\.vercel\\.app" }], "destination": "/personal-llms.txt" },
    { "source": "/favicon.svg", "has": [{ "type": "host", "value": "(www\\.)?bhanubeyond\\.com|bhanukiran\\.vercel\\.app" }], "destination": "/personal-favicon.svg" },
    { "source": "/((?!api/|assets/|images/|personal-|professional\\.html).*)", "has": [{ "type": "host", "value": "(www\\.)?bhanubeyond\\.com|bhanukiran\\.vercel\\.app" }], "destination": "/professional.html" },
    { "source": "/professional.html", "has": [{ "type": "host", "value": "bbtech\\.bhanubeyond\\.com" }], "destination": "/index.html" },
    { "source": "/work-with-me", "destination": "/index.html" },
    { "source": "/web-experiences", "destination": "/index.html" },
    { "source": "/custom-software", "destination": "/index.html" },
    { "source": "/ai-automation", "destination": "/index.html" },
    { "source": "/insights", "destination": "/index.html" },
    { "source": "/insights/(.*)", "destination": "/index.html" },
    { "source": "/privacy", "destination": "/index.html" },
    { "source": "/terms", "destination": "/index.html" }
  ]
}
